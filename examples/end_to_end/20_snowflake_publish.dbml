TableGroup snowflake_publish [color: #A3D5C8] {
  publish.dim_customer
  publish.dim_product
  publish.fact_order_line
}

Table publish.dim_customer {
  customer_key   integer   [pk, increment]
  customer_id    integer
  customer_name  varchar
  country_code   varchar

  Note: '''
    source table: stage.customer
    notebook: dbt/models/marts/dim_customer.sql
  '''
}

Table publish.dim_product {
  product_key   integer   [pk, increment]
  product_id    integer
  product_name  varchar
  category      varchar
  list_price    decimal

  Note: '''
    source table: stage.product + stage.pricelist (join)
    notebook: dbt/models/marts/dim_product.sql
  '''
}

Table publish.fact_order_line {
  order_line_id  integer   [pk]
  customer_key   integer   [ref: > publish.dim_customer.customer_key]
  product_key    integer   [ref: > publish.dim_product.product_key]
  order_date     date
  quantity       integer
  line_amount    decimal

  Note: '''
    source table: stage.order + stage.order_line (join)
    notebook: dbt/models/marts/fact_order_line.sql
    remark: grain is one row per order line, not per order
  '''
}
