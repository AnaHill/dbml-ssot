TableGroup postgres_staging [color: #C6E2FF] {
  staging.customer
  staging.order
  staging.order_line
  staging.product
}

Table staging.customer {
  customer_id    integer   [pk]
  customer_name  varchar
  email          varchar
  country_code   varchar

  Note: '''
    source table: crm.customer
    notebook: staging.sp_load_customer
    mechanism: stored_procedure
  '''
}

Table staging.order {
  order_id     integer   [pk]
  customer_id  integer   [ref: > staging.customer.customer_id]
  order_date   date
  status       varchar

  Note: '''
    source table: webshop.order
    notebook: staging.sp_load_order
    mechanism: stored_procedure
  '''
}

Table staging.order_line {
  order_line_id  integer   [pk]
  order_id       integer   [ref: > staging.order.order_id]
  product_id     integer   [ref: > staging.product.product_id]
  quantity       integer
  unit_price     decimal

  Note: '''
    source table: webshop.order_line
    notebook: staging.sp_load_order_line
    mechanism: stored_procedure
  '''
}

Table staging.product {
  product_id    integer   [pk]
  product_code  varchar
  product_name  varchar
  category      varchar
  list_price    decimal

  Note: '''
    source table: erp.product + legacy.pricelist (join)
    notebook: staging.sp_load_product
    mechanism: stored_procedure
  '''
}
